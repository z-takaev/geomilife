{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "format": "prettier --write \"resources/**/*.{blade.php,html,css,js,json}\" \"public/assets/css/styles.css\" \"public/assets/js/{alpine,carousel,main}.js\"",
        "format:check": "prettier --check \"resources/**/*.{blade.php,html,css,js,json}\" \"public/assets/css/styles.css\" \"public/assets/js/{alpine,carousel,main}.js\""
    },
    "devDependencies": {
        "@shufo/prettier-plugin-blade": "^1.16.2",
        "concurrently": "^10.0.3",
        "prettier": "^3.9.9"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}

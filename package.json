{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "format": "prettier --write \"resources/**/*.{blade.php,html,css,js,json}\" \"public/assets/css/styles.css\" \"public/assets/js/{carousel,main}.js\"",
        "format:check": "prettier --check \"resources/**/*.{blade.php,html,css,js,json}\" \"public/assets/css/styles.css\" \"public/assets/js/{carousel,main}.js\""
    },
    "devDependencies": {
        "@shufo/prettier-plugin-blade": "^1.16.2",
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.9",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "alpinejs": "^3.17.4"
    }
}
